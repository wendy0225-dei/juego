<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Memorama</title>

<style>
body{
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg,#4facfe,#00f2fe);
    display:flex;
    flex-direction:column;
    align-items:center;
    min-height:100vh;
    margin:0;
}

h1{
    color:white;
}

#movimientos{
    color:white;
    font-size:20px;
    margin-bottom:15px;
}

.tablero{
    display:grid;
    grid-template-columns:repeat(4,100px);
    gap:10px;
}

.carta{
    width:100px;
    height:100px;
    background:#1f2937;
    border-radius:10px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:40px;
    cursor:pointer;
    color:transparent;
    transition:0.3s;
    user-select:none;
}

.carta.volteada{
    background:white;
    color:black;
}

.carta.acertada{
    background:#4CAF50;
    color:white;
    cursor:default;
}
</style>
</head>
<body>

<h1>🧠 Memorama</h1>
<div id="movimientos">Movimientos: 0</div>

<div class="tablero" id="tablero"></div>

<script>

const emojis = [
    "🍎","🍎",
    "🍌","🍌",
    "🍇","🍇",
    "🍉","🍉",
    "🍒","🍒",
    "🍓","🍓",
    "🥝","🥝",
    "🍍","🍍"
];

emojis.sort(() => Math.random() - 0.5);

const tablero = document.getElementById("tablero");

let primeraCarta = null;
let segundaCarta = null;
let bloqueo = false;
let movimientos = 0;
let parejas = 0;

document.getElementById("movimientos").textContent =
"Movimientos: 0";

emojis.forEach(emoji => {

    const carta = document.createElement("div");
    carta.classList.add("carta");
    carta.textContent = emoji;

    carta.addEventListener("click", () => {

        if(
            bloqueo ||
            carta.classList.contains("volteada") ||
            carta.classList.contains("acertada")
        ){
            return;
        }

        carta.classList.add("volteada");

        if(!primeraCarta){
            primeraCarta = carta;
            return;
        }

        segundaCarta = carta;
        movimientos++;

        document.getElementById("movimientos").textContent =
        "Movimientos: " + movimientos;

        if(
            primeraCarta.textContent ===
            segundaCarta.textContent
        ){

            primeraCarta.classList.add("acertada");
            segundaCarta.classList.add("acertada");

            parejas++;

            primeraCarta = null;
            segundaCarta = null;

            if(parejas === 8){
                setTimeout(()=>{
                    alert(
                        "🎉 ¡Ganaste!\nMovimientos: " +
                        movimientos
                    );
                },300);
            }

        }else{

            bloqueo = true;

            setTimeout(()=>{

                primeraCarta.classList.remove("volteada");
                segundaCarta.classList.remove("volteada");

                primeraCarta = null;
                segundaCarta = null;
                bloqueo = false;

            },1000);
        }

    });

    tablero.appendChild(carta);

});

</script>

</body>
</html>
